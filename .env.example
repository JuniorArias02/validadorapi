# ─────────────────────────────────────────────
# Variables de entorno — API Central
# ─────────────────────────────────────────────

# ─── Base de datos MySQL ───────────────────────────────────────────────
# Desarrollo local (MySQL en tu máquina):
DATABASE_URL="mysql://usuario:contraseña@localhost:3306/validador_db"

# Dentro de Docker (MySQL en el servidor host):
# En Linux, usar host.docker.internal o la IP del host:
# DATABASE_URL="mysql://usuario:contraseña@host.docker.internal:3306/validador_db"
# DATABASE_URL="mysql://usuario:contraseña@172.17.0.1:3306/validador_db"

# ─── Servidor ─────────────────────────────────────────────────────────
PORT=3000

# ─── Lógica de negocio ────────────────────────────────────────────────
# Minutos antes de liberar un trabajo de validación abandonado
TIEMPO_BLOQUEO_VALIDACION=15

# ─── Entorno ──────────────────────────────────────────────────────────
NODE_ENV=development
